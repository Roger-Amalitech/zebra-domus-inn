PORT=5000
MONGODB_URI=your-mongodb-atlas-connection-string

# Owner sign-in for the admin dashboard (admin.html)
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=at-least-8-characters
# Optional: the name shown in the dashboard
ADMIN_NAME=Owner
# Optional: any long random text; keeps staff signed in when the server restarts
ADMIN_TOKEN_SECRET=
